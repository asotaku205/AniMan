DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
PORT=8080
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional; use temporarily only when intentionally promoting an existing account.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# User work uploads (Admin Lat 2A): files are stored on server disk.
# Leave empty to use the default server/uploads directory.
UPLOADS_DIR=

# Reference image generation (Cloudflare Workers AI, Manga Studio).
# Set REFERENCE_IMAGE_ENABLED=true only on a server allowed to spend the
# account daily neuron pool. Never commit real values.
REFERENCE_IMAGE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
